{
  "name": "my-astro-static-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "heantee.foo/*", "custom_domain": true },
    { "pattern": "www.heantee.foo/*", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}