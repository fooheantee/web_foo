---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Foo HeanTee | Identity & Access Security Engineer"
			description="Personal site of Foo HeanTee, a cybersecurity engineer with 20 years in IT. Notes on IAM, PAM, Microsoft Entra ID, and homelab projects."
		/>
	</head>
	<body>
		<Header />
		<main>
			<p><em><code>foo</code> (noun): A temporary placeholder, or just my actual surname.</em></p>
			<h1>Hi, I’m Foo: an identity and cybersecurity engineer.</h1>
			<p>Yes, Foo is my real surname. So registering <code>heantee.foo</code> is a must.</p>
			<p>Pretty cool, ya?</p>

			<h2>What You’ll Find Here</h2>
			<ul>
				<li><strong><a href="/blog/">Blog</a>:</strong> Tech write-ups, lab experiments, and the occasional rabbit hole.</li>
				<li><strong><a href="/blog/?category=homelab">Homelab</a>:</strong> A mini PC, some VMs, and a lot of "why is this not working?"</li>
				<li><strong><a href="/about/">About</a>:</strong> The serious bit, for when you need proof I'm a real person.</li>
			</ul>

			<h2>What I Do</h2>
			<p>I work in cybersecurity and identity, focusing on who gets access to what and how to keep the wrong people out.</p>
			<p>I’m here to learn, experiment, and document what works and what breaks along the way.</p>
			<p>Have a look around. You might find something useful, or at least meet someone who turned a surname into a domain.</p>

			{recentPosts.length > 0 && (
				<>
					<h2>Recent Posts</h2>
					<ul>
						{recentPosts.map((post) => (
							<li>
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('en-GB', {
										day: '2-digit',
										month: '2-digit',
										year: 'numeric',
									})}
								</time>
								{' — '}
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</li>
						))}
					</ul>
					<p><a href="/blog/">View all posts</a></p>
				</>
			)}
		</main>
		<Footer />
	</body>
</html>