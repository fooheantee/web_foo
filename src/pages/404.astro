---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <main style="text-align: center; padding: 4rem 2rem;">
    <h1>404: Lost in Space</h1>
    <p>Oops! The page you are looking for doesn't exist or has moved.</p>
    <a href="/" style="display: inline-block; margin-top: 1rem; color: #0070f3;">
      Return Home
    </a>
  </main>
</BaseLayout>
