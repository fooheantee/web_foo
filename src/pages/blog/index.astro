---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categoryCounts = posts.reduce<Record<string, number>>((acc, post) => {
	const key = (post.data.category || '').toLowerCase();
	if (key) {
		acc[key] = (acc[key] ?? 0) + 1;
	}
	return acc;
}, {});

const categories = [
	{ id: 'all', label: 'All', count: posts.length },
	{ id: 'identity', label: 'Identity', count: categoryCounts.identity ?? 0 },
	{ id: 'homelab', label: 'Homelab', count: categoryCounts.homelab ?? 0 },
	{ id: 'security', label: 'Security', count: categoryCounts.security ?? 0 },
	{ id: 'dev', label: 'Dev', count: categoryCounts.dev ?? 0 },
	{ id: 'architecture', label: 'Architecture', count: categoryCounts.architecture ?? 0 },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Blog | Foo HeanTee"
			description="Write-ups on identity and access management, security engineering, and homelab experiments by Foo HeanTee."
		/>
		<style>
			main {
				width: 100%;
				max-width: var(--max-width);
				margin: 0 auto;
			}

			.page-title {
				font-size: 1.1rem;
				font-weight: 500;
				color: var(--muted-text);
				margin: 0 0 1.25rem 0;
				letter-spacing: 0.02em;
			}

			/* Category Filter Pills */
			.category-filter {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 2rem;
			}

			.filter-pill {
				display: inline-block;
				font-size: 0.85rem;
				padding: 0.3rem 0.8rem;
				border-radius: 9999px;
				background-color: var(--code-bg);
				color: var(--muted-text);
				border: 1px solid var(--border-color);
				text-decoration: none;
				scroll-margin-top: 7rem;
				transition: all 0.15s ease;
			}

			.filter-pill:hover {
				color: var(--text-color);
				border-color: var(--accent-color);
			}

			.filter-pill:focus-visible {
				border-radius: 9999px;
			}

			.filter-pill.active {
				background-color: var(--accent-color);
				color: #ffffff;
				border-color: var(--accent-color);
				font-weight: 500;
			}

			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
				transition: opacity 0.15s ease;
			}
			ul li[hidden] {
				display: none !important;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}

			/* Full-Width Featured Card Styling when on All view */
			.filter-all ul li:first-child {
				width: 100%;
			}
			.filter-all ul li:first-child a {
				padding: 1.5rem;
				border-radius: 12px;
				background-color: var(--code-bg);
				border: 1px solid var(--border-color);
				transition: border-color 0.15s ease;
			}
			.filter-all ul li:first-child a:hover,
			.filter-all ul li:first-child a:focus-visible {
				border-color: var(--accent-color);
			}
			.filter-all ul li:first-child a:focus-visible {
				border-radius: 12px;
			}
			.filter-all ul li:first-child .title {
				font-size: 1.75rem;
			}
			.filter-all ul li:first-child .meta-row {
				justify-content: flex-start;
			}

			.latest-badge {
				display: none;
				margin-left: 0.25rem;
				padding: 0.1rem 0.55rem;
				border-radius: 9999px;
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.03em;
				text-transform: uppercase;
				background-color: var(--background-color);
				color: var(--accent-color);
				border: 1px solid var(--border-color);
			}
			.filter-all ul li:first-child .latest-badge {
				display: inline-block;
			}

			.featured-desc {
				display: none;
				margin: 0.65rem 0 0 0;
				color: var(--muted-text);
				font-size: 0.95rem;
				line-height: 1.5;
			}
			.filter-all ul li:first-child .featured-desc {
				display: block;
			}

			ul li a {
				display: block;
				scroll-margin-top: 7rem;
			}
			.meta-row {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.4rem;
				color: var(--muted-text);
			}
			.title {
				margin: 0;
				color: var(--text-color);
				line-height: 1.25;
			}
			.date {
				margin: 0;
				font-size: 0.9em;
				color: var(--muted-text);
			}

			/* Hover and Keyboard Focus Highlights */
			ul li a:hover h4,
			ul li a:focus-visible h4 {
				color: var(--accent-color);
			}
			ul li a:hover :global(.category-icon),
			ul li a:focus-visible :global(.category-icon) {
				color: var(--accent-color);
				transform: translateY(-1px);
			}

			.no-posts-message {
				color: var(--muted-text);
				font-style: italic;
				margin-top: 1rem;
			}

			@media (max-width: 720px) {
				.page-title {
					font-size: 1rem;
					margin-bottom: 1rem;
				}
				ul {
					gap: 1.5em;
				}
				ul li {
					width: 100%;
					text-align: left;
				}
				.filter-all ul li:first-child a {
					padding: 1.25rem 1rem;
				}
				.filter-all ul li:first-child .title {
					font-size: 1.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">Blog: identity security and homelab notes</h1>

			<nav class="category-filter" aria-label="Filter blog posts by category">
				{categories.map((cat) => (
					<a
						href={cat.id === 'all' ? '/blog/' : `/blog/?category=${cat.id}`}
						class="filter-pill"
						data-category={cat.id}
					>
						{cat.label} ({cat.count})
					</a>
				))}
			</nav>

			<section id="posts-container" class="filter-all">
				<ul id="post-list">
					{posts.map((post, index) => (
						<li data-category={post.data.category}>
							<a href={`/blog/${post.id}/`}>
								<div class="meta-row">
									<CategoryIcon category={post.data.category} size={18} />
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									{index === 0 && <span class="latest-badge">Latest</span>}
								</div>
								<h4 class="title">{post.data.title}</h4>
								{index === 0 && post.data.description && (
									<p class="featured-desc">{post.data.description}</p>
								)}
							</a>
						</li>
					))}
				</ul>
				<p id="no-posts" class="no-posts-message" hidden>No posts found in this category.</p>
			</section>
		</main>
		<Footer />

		<script>
			const pills = Array.from(
				document.querySelectorAll<HTMLAnchorElement>('.category-filter .filter-pill'),
			);
			const validCategories = new Set(
				pills.map((pill) => pill.dataset.category).filter((cat): cat is string => Boolean(cat)),
			);

			function applyFilter(rawCategory: string) {
				const normalized = rawCategory.trim().toLowerCase();
				const targetCategory =
					normalized && validCategories.has(normalized) ? normalized : 'all';

				const container = document.getElementById('posts-container');
				if (container) {
					container.classList.toggle('filter-all', targetCategory === 'all');
				}

				pills.forEach((pill) => {
					const isMatch = pill.dataset.category === targetCategory;
					pill.classList.toggle('active', isMatch);
					if (isMatch) {
						pill.setAttribute('aria-current', 'true');
					} else {
						pill.removeAttribute('aria-current');
					}
				});

				const items = document.querySelectorAll<HTMLLIElement>('#post-list li');
				let visibleCount = 0;
				items.forEach((item) => {
					const itemCategory = (item.dataset.category || '').toLowerCase();
					const isVisible = targetCategory === 'all' || itemCategory === targetCategory;
					item.hidden = !isVisible;
					if (isVisible) {
						visibleCount++;
					}
				});

				const noPosts = document.getElementById('no-posts');
				if (noPosts) {
					noPosts.hidden = visibleCount > 0;
				}
			}

			function syncFromUrl() {
				const params = new URLSearchParams(window.location.search);
				const queryCategory = params.get('category');
				const hashCategory = window.location.hash.replace(/^#/, '');
				applyFilter(queryCategory || hashCategory || 'all');
			}

			pills.forEach((pill) => {
				pill.addEventListener('click', (event) => {
					event.preventDefault();
					const selected = pill.dataset.category || 'all';
					const url = new URL(window.location.href);

					if (selected === 'all') {
						url.searchParams.delete('category');
					} else {
						url.searchParams.set('category', selected);
					}
					url.hash = '';

					window.history.replaceState({}, '', `${url.pathname}${url.search}`);
					applyFilter(selected);
				});
			});

			window.addEventListener('popstate', syncFromUrl);
			window.addEventListener('hashchange', syncFromUrl);
			syncFromUrl();
		</script>
	</body>
</html>