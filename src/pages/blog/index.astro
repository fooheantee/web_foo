---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = [
	{ id: 'all', label: 'All' },
	{ id: 'identity', label: 'Identity' },
	{ id: 'homelab', label: 'Homelab' },
	{ id: 'security', label: 'Security' },
	{ id: 'dev', label: 'Dev' },
	{ id: 'architecture', label: 'Architecture' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog | Foo HeanTee" description="Write-ups on identity and access management, security engineering, and homelab experiments by Foo HeanTee." />
		<style>
			main {
				width: 100%;
				max-width: var(--max-width);
				margin: 0 auto;
			}
			
			.page-title {
				font-size: 1.1rem;
				font-weight: 500;
				color: var(--muted-text);
				margin: 0 0 1.25rem 0;
				letter-spacing: 0.02em;
			}

			/* Category Filter Pills */
			.category-filter {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 2rem;
			}

			.filter-pill {
				display: inline-block;
				font-size: 0.85rem;
				padding: 0.3rem 0.8rem;
				border-radius: 9999px;
				background-color: var(--code-bg);
				color: var(--muted-text);
				border: 1px solid var(--border-color);
				text-decoration: none;
				transition: all 0.15s ease;
			}

			.filter-pill:hover {
				color: var(--text-color);
				border-color: var(--accent-color);
			}

			.filter-pill.active {
				background-color: var(--accent-color);
				color: #ffffff;
				border-color: var(--accent-color);
				font-weight: 500;
			}

			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
				transition: opacity 0.15s ease;
			}
			ul li[hidden] {
				display: none !important;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			
			/* Featured Card Styling when on All view */
			.filter-all ul li:first-child a {
				padding: 1.75rem 1.5rem;
				border-radius: 12px;
				background-color: var(--card-bg, rgba(128, 128, 128, 0.05));
				border: 1px solid var(--border-color, rgba(128, 128, 128, 0.12));
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
			}
			.filter-all ul li:first-child .title {
				font-size: 2rem;
			}
			.filter-all ul li:first-child .meta-row {
				justify-content: flex-start;
			}

			ul li a {
				display: block;
			}
			.meta-row {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.4rem;
				color: var(--muted-text);
			}
			.title {
				margin: 0;
				color: var(--text-color);
				line-height: 1.25;
			}
			.date {
				margin: 0;
				font-size: 0.9em;
				color: var(--muted-text);
			}
			
			/* Hover Highlights */
			ul li a:hover h4 {
				color: var(--accent-color);
			}
			ul li a:hover :global(.category-icon) {
				color: var(--accent-color);
				transform: translateY(-1px);
			}

			.no-posts-message {
				color: var(--muted-text);
				font-style: italic;
				margin-top: 1rem;
			}

			@media (max-width: 720px) {
				.page-title {
					font-size: 1rem;
					margin-bottom: 1rem;
				}
				ul {
					gap: 1.5em;
				}
				ul li {
					width: 100%;
					text-align: left;
				}
				.filter-all ul li:first-child a {
					padding: 1.25rem 1rem;
				}
				.filter-all ul li:first-child .title {
					font-size: 1.5em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">Blog: identity security and homelab notes</h1>
			
			<nav class="category-filter" aria-label="Filter blog posts by category">
				{categories.map((cat) => (
					<a
						href={cat.id === 'all' ? '/blog' : `#${cat.id}`}
						class="filter-pill"
						data-category={cat.id}
					>
						{cat.label}
					</a>
				))}
			</nav>

			<section id="posts-container" class="filter-all">
				<ul id="post-list">
					{posts.map((post) => (
						<li data-category={post.data.category}>
							<a href={`/blog/${post.id}/`}>
								<div class="meta-row">
									<CategoryIcon category={post.data.category} size={18} />
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
								<h4 class="title">{post.data.title}</h4>
							</a>
						</li>
					))}
				</ul>
				<p id="no-posts" class="no-posts-message" hidden>No posts found in this category.</p>
			</section>
		</main>
		<Footer />

		<script>
			function updateFilter() {
				const hash = window.location.hash.replace('#', '').toLowerCase();
				const targetCategory = hash && hash !== 'all' ? hash : 'all';

				const container = document.getElementById('posts-container');
				if (container) {
					if (targetCategory === 'all') {
						container.classList.add('filter-all');
					} else {
						container.classList.remove('filter-all');
					}
				}

				// Update active pill styling
				const pills = document.querySelectorAll('.category-filter .filter-pill');
				pills.forEach((pill) => {
					const cat = pill.getAttribute('data-category');
					if (cat === targetCategory) {
						pill.classList.add('active');
						pill.setAttribute('aria-current', 'true');
					} else {
						pill.classList.remove('active');
						pill.removeAttribute('aria-current');
					}
				});

				// Show/hide matching posts
				const items = document.querySelectorAll('#post-list li');
				let visibleCount = 0;
				items.forEach((item) => {
					const itemCategory = item.getAttribute('data-category');
					if (targetCategory === 'all' || itemCategory === targetCategory) {
						item.removeAttribute('hidden');
						visibleCount++;
					} else {
						item.setAttribute('hidden', '');
					}
				});

				// Toggle empty state message
				const noPosts = document.getElementById('no-posts');
				if (noPosts) {
					if (visibleCount === 0) {
						noPosts.removeAttribute('hidden');
					} else {
						noPosts.setAttribute('hidden', '');
					}
				}
			}

			window.addEventListener('DOMContentLoaded', updateFilter);
			window.addEventListener('hashchange', updateFilter);
			updateFilter();
		</script>
	</body>
</html>
