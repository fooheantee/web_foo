---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog | Foo HeanTee" description="Write-ups on identity and access management, security engineering, and homelab experiments by Foo HeanTee." />
		<style>
			main {
				width: 100%;
				max-width: var(--max-width);
				margin: 0 auto;
			}
			
			/* Softened Section Header */
			.page-title {
				font-size: 1.1rem;
				font-weight: 500;
				color: var(--muted-text);
				margin: 0 0 2rem 0;
				letter-spacing: 0.02em;
			}

			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			
			/* Featured Hero Card Styling */
			ul li:first-child {
				width: 100%;
				margin-bottom: 0.5rem;
				text-align: left;
			}
			ul li:first-child a {
				padding: 1.75rem 1.5rem;
				border-radius: 12px;
				background-color: var(--card-bg, rgba(128, 128, 128, 0.05));
				border: 1px solid var(--border-color, rgba(128, 128, 128, 0.12));
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
			}
			ul li:first-child .title {
				font-size: 2rem;
			}
			ul li:first-child .meta-row {
				justify-content: flex-start;
			}

			ul li a {
				display: block;
			}
			.meta-row {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.4rem;
				color: var(--muted-text);
			}
			.title {
				margin: 0;
				color: var(--text-color);
				line-height: 1.25;
			}
			.date {
				margin: 0;
				font-size: 0.9em;
				color: var(--muted-text);
			}
			
			/* Hover Highlights */
			ul li a:hover h4 {
				color: var(--accent-color);
			}
			ul li:first-child a:hover {
				border-color: var(--accent-color);
				transform: translateY(-2px);
			}
			ul li a:hover :global(.category-icon) {
				color: var(--accent-color);
				transform: translateY(-1px);
			}

			@media (max-width: 720px) {
				.page-title {
					font-size: 1rem;
					margin-bottom: 1.5rem;
				}
				ul {
					gap: 1.5em;
				}
				ul li {
					width: 100%;
					text-align: left;
				}
				ul li:first-child a {
					padding: 1.25rem 1rem;
				}
				ul li:first-child .title {
					font-size: 1.5em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">Blog: identity security and homelab notes</h1>
			<section>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<div class="meta-row">
									<CategoryIcon category={post.data.category} size={18} />
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
								<h4 class="title">{post.data.title}</h4>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>