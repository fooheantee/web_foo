---
const today = new Date();
---

<footer>
	<p class="copyright">
		© {today.getFullYear()} Foo HeanTee. All rights reserved.
	</p>
	<div class="social-links">
		<a
			href="https://www.linkedin.com/in/fooheantee/"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Connect with me on LinkedIn"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" fill="currentColor">
				<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"/>
			</svg>
		</a>
		<a
			href="/rss.xml"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Subscribe to RSS Feed"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24" fill="currentColor">
				<path d="M12 20.001c0-4.41-3.59-8-8-8v-3c6.065 0 11 4.935 11 11zm8 0c0-8.822-7.178-16-16-16v-3c10.477 0 19 8.523 19 19zM6.5 20a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/>
			</svg>
		</a>
	</div>
</footer>

<style>
	footer {
		padding: 3rem 1rem;
		margin-top: 4rem;
		border-top: 1px solid var(--border-color);
		background-color: var(--background-color);
		color: var(--muted-text);
		text-align: center;
		font-size: 0.875rem;
		transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.copyright {
		margin: 0;
	}

	.social-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.75rem;
		margin-top: 1rem;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		color: var(--muted-text);
		border-radius: 6px;
		transition: color 0.15s ease, background-color 0.15s ease;
		text-decoration: none;
	}

	.social-links a:hover {
		color: var(--accent-color);
		background-color: var(--code-bg);
	}

	.social-links a:focus-visible {
		outline: 2px solid var(--accent-color);
		outline-offset: 2px;
	}
</style>